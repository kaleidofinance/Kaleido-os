# ============================================
# Kaleido Finance - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================
# Contract Addresses (Abstract Testnet)
# ============================================
# Main Diamond contract - EIP-2535 Diamond Standard
NEXT_PUBLIC_KALEIDO_DIAMOND_ADDRESS=0x7286F2708f8f4d0a1a1b6c19f5D14AdB4c3207B2

# Deployer/signer private key used by scripts and the off-chain server.
# NEVER commit a real key. Provide it via your local, untracked .env file.
PRIVATE_KEY=your_private_key_here

# Token Faucet contract for claiming test tokens
NEXT_PUBLIC_TOKENFAUCET_ADDRESS=0xC99eddf1f7C9250728A47978732928aE158396E7

# KLD Vault contract for liquid staking
NEXT_PUBLIC_KLD_VAULT_ADDRESS=0xb6fb7fd04eCF2723f8a5659134a145Bd7fE68748

# Protocol contract address
NEXT_PUBLIC_PROTOCOL_ADDRESS=0xBCc9e3d13CeB24C46Aa2BC7521265B3ace4bb410

# Pyth Oracle contract for price feeds
NEXT_PUBLIC_PYTH_ORACLE_ADDRESS=0xCCd51348cD067adD83747AD7082E557257f7C17d

# ============================================
# RPC URLs
# ============================================
# HTTP RPC endpoint (general)
NEXT_PUBLIC_HTTP_RPC=https://api.testnet.abs.xyz

# WebSocket RPC endpoint (for real-time subscriptions)
NEXT_PUBLIC_WEBSOCKET_RPC=wss://api.testnet.abs.xyz

# HTTP RPC for Abstract network specifically
NEXT_PUBLIC_HTTP_RPC_AB=https://api.testnet.abs.xyz

# ============================================
# Third-party Services
# ============================================
# Thirdweb Client ID (for wallet connection)
NEXT_PUBLIC_THIRDWEB_CLIENT_KEY=your_thirdweb_client_id_here

# Supabase URL (for database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Key (public API key)
NEXT_PUBLIC_SUPABASE_KEY=your_supabase_anon_key_here

# Supabase service-role key. SERVER ONLY — it bypasses row-level security, so
# anyone holding it can read and write every table. Never prefix it with
# NEXT_PUBLIC_. Without it, Luca's model-request quota is not enforced and the
# agent runs unmetered.
SUPABASE_SERVICE_ROLE_KEY=

# Model requests each wallet may spend per UTC day. Direct commands are free and
# never counted, so this only rations provider calls. Defaults to 25.
# AGENT_DAILY_MODEL_REQUESTS=25

# ============================================
# Twitter/X Authentication
# ============================================
# Twitter OAuth Client ID
NEXT_PUBLIC_TWITTER_CLIENT_ID=your_twitter_client_id_here

# Twitter OAuth Redirect URI
NEXT_PUBLIC_TWITTER_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Twitter API Key
NEXT_PUBLIC_TWITTER_KEY=your_twitter_api_key_here

# ============================================
# Analytics
# ============================================
# Google Analytics Measurement ID (optional)
NEXT_PUBLIC_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# AI providers (Luca)
# ============================================
# Luca picks a provider from whichever key is set. Set AI_PROVIDER to force
# one, or leave it unset and the first configured key wins (Claude, then
# OpenAI). Adding a provider is one adapter in src/lib/ai/providers.
#
# Server-side only — never prefix these with NEXT_PUBLIC_, or the key ships
# to every visitor in the browser bundle.
# AI_PROVIDER=claude

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5

# Legacy external AI engine. Used only when no provider key above is set.
# AI_ENGINE_API_URL=http://127.0.0.1:8000
# AI_ENGINE_TIMEOUT=300000

# ============================================
# Notes
# ============================================
# - All NEXT_PUBLIC_* variables are exposed to the browser
# - Never put sensitive keys in NEXT_PUBLIC_* variables
# - For production, use environment-specific values
# - Contract addresses are for Abstract Testnet (Chain ID: 11124)
# - For other networks, update addresses accordingly

# --- MoonPay: fiat on-ramp (Buy) and off-ramp (Sell) ---
# Publishable key. Safe in the browser; it identifies your MoonPay account.
NEXT_PUBLIC_MOONPAY_API_KEY=
# Secret key. SERVER ONLY — it signs widget URLs, so anyone holding it can mint
# signed URLs against your account. Never prefix this with NEXT_PUBLIC_.
MOONPAY_SECRET_KEY=
# "live" switches to buy.moonpay.com / sell.moonpay.com. Anything else stays
# on the sandbox, which is where you should verify the signature first.
MOONPAY_ENV=sandbox
