# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# The deployer key previously lived in hardhat.config.js and in five scripts,
# all committed. Those keys are permanently public and must never be reused.
# Generate a fresh deployer offline for mainnet, ideally one whose only job is
# deploying, and hand ownership to a multisig immediately afterwards.

# Deployer. 64 hex chars, with or without the 0x prefix.
DEPLOYER_PRIVATE_KEY=

# --- RPC overrides (all optional; each falls back to a public endpoint) ---
# Public endpoints are rate-limited and fine for testnet. Use a provider URL
# for mainnet deploys, where a dropped request mid-deploy is expensive.
ABSTRACT_MAINNET_RPC=
ABSTRACT_TESTNET_RPC=
ETHEREUM_RPC=
SEPOLIA_RPC=
BASE_RPC=
BASE_SEPOLIA_RPC=
BSC_RPC=
BSC_TESTNET_RPC=
ROBINHOOD_RPC=
ROBINHOOD_TESTNET_RPC=
ARC_TESTNET_RPC=

# --- Block explorer API keys, for contract verification ---
# The two Abscan keys that used to be hardcoded here are public now; rotate
# them. These only affect verification, so a leak is far less severe than the
# deployer key — but rotate anyway.
ABSCAN_API_KEY=
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=
BSCSCAN_API_KEY=

# Robinhood Chain and Arc run Blockscout, which does not require a key — both
# default to the literal "blockscout" in hardhat.config.js, which is what the
# Blockscout verification API expects in the apiKey slot. Set these only if the
# instance in front of you is gated. Leaving them blank is correct.
ROBINHOOD_EXPLORER_API_KEY=
ARCSCAN_API_KEY=

# --- Oracle, applied by scripts/deploy-oracle.js (runs FIRST, before deploy.js) ---

# Optional. Which oracle backend this chain gets: pyth | aggregator-v3.
#
# Defaults per chain from scripts/libraries/aggregator-feeds.js, which records the
# evidence for each: pyth on Base Sepolia and Arc Testnet, where Pyth publishes
# every ~90-104s; aggregator-v3 on Sepolia and BSC Testnet (Chainlink) and on
# Robinhood Testnet (an API3 dAPI), where Pyth is stale or absent entirely.
#
# The diamond does not care. It asks its oracle for exactly one thing —
# getPrice(bytes32) -> PythStructs.Price — and _priceScaled18 already handles an
# arbitrary expo, so the backend is a deployment-time choice rather than a protocol
# change. AggregatorPriceOracle normalises Chainlink's 8 decimals and API3's 18 to
# expo = -8, the same shape a Pyth USD feed reports. Without that rescale an
# 18-decimal API3 answer overflows the int64 in PythStructs.Price: ETH at $2,345.64
# arrives as 2.345e21 against a max of 9.22e18.
#
# Set this only to override the table. A value that contradicts what a deployed
# oracle reports from oracleKind() is refused rather than obeyed.
#ORACLE_BACKEND=aggregator-v3

# Optional, per symbol on an aggregator chain: AGGREGATOR_ETH, AGGREGATOR_USDC,
# AGGREGATOR_BNB, AGGREGATOR_BTC, AGGREGATOR_WETH. A Chainlink aggregator or API3
# reader-proxy address that overrides the table, the same escape hatch FEED_<SYMBOL>
# gives for Pyth ids.
#
# An overridden feed is given maxAge 0 — inherit the global bound — on purpose. A
# staleness bound is a risk parameter and inventing one for an address typed on a
# command line would be guessing. Set FEED_MAX_AGE_<SYMBOL> alongside it if that
# is not what you want.
#
# ETH and WETH share one Pyth feed id, and the bound and the aggregator are stored
# per id. Overriding one and not the other is refused rather than resolved, because
# object iteration order would otherwise decide which address wins, silently.
#AGGREGATOR_ETH=

# Optional, per symbol: FEED_MAX_AGE_ETH, FEED_MAX_AGE_USDC, and so on. Seconds.
# Installed on the diamond by scripts/register-tokens.js via setFeedMaxAge, not by
# deploy-oracle.js — the diamond does not exist yet when that runs.
#
# Exists because one number cannot describe the publisher cadences the protocol has
# to read. Sepolia measured Chainlink ETH/USD at 1,594s old and USDC/USD at 13,438s
# IN THE SAME BLOCK — an 8x spread on one chain, against a global
# PRICE_MAX_AGE_SECONDS of 300. Loose enough for the stablecoin accepts a
# four-hour-old ETH price to liquidate against; tight enough for ETH and the
# stablecoin never prices, which takes /borrow down on that chain entirely.
#
# Capped at 90000 (25h) by Constants.MAX_FEED_PRICE_AGE, above PRICE_MAX_AGE's own
# one-hour cap, because API3's only heartbeat option is 24 hours.
#
# ONLY DEFENSIBLE ON A PEGGED ASSET. A day-old USDC quote is very probably still a
# dollar; a day-old ETH quote is an invitation to liquidate healthy positions at a
# price that stopped being true. Using this to silence a reverting volatile feed
# converts a refusal to price into a wrong price, which is strictly worse. 0 clears
# the override and returns the feed to the global bound; it never disables the check.
#FEED_MAX_AGE_USDC=86400

# REQUIRED by scripts/deploy-oracle.js on a pyth-backend chain only, and only when
# the chain has no entry in aggregator-feeds.js's PYTH_CONTRACTS table.
# Pyth's OWN contract on the target chain:
# https://docs.pyth.network/price-feeds/contract-addresses/evm
#
# This is the only per-chain Pyth value. Price *feed ids* are global and byte
# identical on every chain — see scripts/libraries/pyth-feeds.js.
#
# PythPriceOracle takes it as a constructor argument and stores it `immutable`,
# so a wrong value here cannot be corrected by a setter, only by redeploying the
# oracle and re-running deploy.js's setPythOracle. The script getCode-checks it
# and then calls getValidTimePeriod() on it, because code is not identity: the
# address that is Pyth on Arc Testnet holds 1,067 bytes of something unrelated on
# Robinhood, where that call reverts — which is how Robinhood was found to have no
# Pyth at all.
#
# Not to be confused with PYTH_PRICE_ORACLE below. This is Pyth's contract; that
# one is ours, and is the address this script prints when it finishes.
PYTH_CONTRACT=

# --- Protocol configuration, applied by scripts/deploy.js after the cut ---
# These are per-chain. deploy.js validates them before spending any gas and
# aborts if a required one is missing, because the facet treats an unset value
# as "not configured" and reverts on it: with no fee vault or a zero fee, every
# repayment and every liquidation reverts, and with no price oracle nothing
# that reads a price works at all. That would strand a borrower's collateral.

# REQUIRED. Where protocol revenue accumulates — the interest cut on repayments
# and the protocol's quarter of liquidation penalties. A multisig, not an EOA.
# Note the liquidation revenue arrives as internal collateral positions inside
# the diamond, so the vault has to call withdrawCollateral to realise it.
KALEIDO_FEE_VAULT=

# REQUIRED. OUR PythPriceOracle wrapper — the address scripts/deploy-oracle.js
# prints, not an address from Pyth's documentation. deploy.js passes it to
# ProtocolFacet.setPythOracle, which stores it as an `IPythPriceOracle`, and
# _priceScaled18 calls `getPrice(bytes32)` on it and applies OUR staleness and
# confidence bounds (PRICE_MAX_AGE_SECONDS / PRICE_MAX_CONF_BPS below) to the
# result.
#
# This line used to say "Pyth contract for the target chain" and link Pyth's
# address list, which is PYTH_CONTRACT above. Following that would have set the
# diamond's oracle to Pyth's own contract — and nothing here would have caught
# it: Pyth's contract has code, so the getCode check passes, setPythOracle
# accepts any non-zero address, and Pyth's deprecated getPrice(bytes32) has the
# same ABI signature as ours. The market would have priced against Pyth's own
# internal validity window instead of the bounds configured here, on the chains
# where that function still works at all.
PYTH_PRICE_ORACLE=

# Protocol's share of the interest a loan earns, in basis points.
# Default 1000 = 10%, in the same range as Aave's reserve factor (10-20% of
# borrower interest) and equal to Lido's cut of staking rewards. Capped at 2500
# by Constants.MAX_PROTOCOL_FEE_BPS. This is a share of interest only, never of
# principal. Set to 1 to effectively waive it; 0 is rejected, because the facet
# cannot distinguish a deliberate zero from an unconfigured one.
PROTOCOL_FEE_BPS=1000

# Liquidation penalty, in basis points of the debt cleared. Default 640 = 6.4%,
# taken from the borrower's collateral; the lender is made whole first, then the
# penalty is split 75/25 between the liquidator and the fee vault (480 bps and
# 160 bps). Capped at 1500 by Constants.MAX_LIQUIDATION_PENALTY_BPS, the top of
# Aave v3's bonus range.
#
# Why 640 and not a round 1000: it is Morpho Blue's liquidation incentive at an
# 80% threshold, 1/(0.3*0.8 + 0.7) = 1.0638. That formula scales the incentive to
# how much room the position had, and at this protocol's single 80% liquidation
# threshold it evaluates to a constant, so the number is adopted rather than the
# formula. The penalty is also bounded by what was actually seized above the
# debt, so a smaller one is payable in full across a wider range of collateral
# prices: liquidation becomes possible once collateral falls to 1.25x the debt,
# and the full penalty keeps paying until 1.064x. A 1000 bps penalty stops
# paying out in full at 1.10x, i.e. it goes thin exactly when defaults cluster.
#
# Note it is paid *in* the seized collateral rather than in the loan currency:
# liquidation credits the collateral to the lender, the liquidator and the fee
# vault on the protocol's internal ledger, and each withdraws it themselves.
# Nothing is swapped and nothing leaves the diamond, which is what makes the
# settlement solvent on a peer-to-peer book — the diamond never held the loan
# currency, because a loan goes lender -> borrower directly. That is also why
# the liquidator's share is the larger one: they have to withdraw and sell what
# they are paid in, rather than receiving a spendable asset.
LIQUIDATION_PENALTY_BPS=640

# Optional. KaleidoSwapRouter, for the collateral-swap paths. Warned about, not
# required; settable later with setSwapRouter.
SWAP_ROUTER=

# --- Price freshness policy, applied by deploy.js via setPriceBounds ---
# Both bounds must be non-zero for the protocol to price anything at all:
# _priceScaled18 reverts while either is unset, so deposit, borrow, health
# factor and liquidation are all offline until setPriceBounds has run. That is
# on purpose — a zero read as "no limit" would ship the protocol with its
# staleness check disabled and no way to tell from the outside.
#
# Why a bound is needed: PythPriceOracle.getPrice calls pyth.getPriceUnsafe,
# which by contract returns the last published price at ANY age, and updates
# come only from updatePrice, which is onlyOwner. A pusher that stops therefore
# leaves the protocol quoting a frozen price indefinitely.

# Oldest accepted Pyth publishTime, in seconds. Match this to your pusher's
# actual interval plus one missed round — 300 assumes roughly 2 minutes.
# Capped at 3600 by Constants.MAX_PRICE_AGE.
#
# Read a second time by scripts/register-tokens.js and scripts/probe-pyth.js, as
# the bound their pre-flight check judges each feed against: a feed already older
# than this on the target chain is reported before anything is registered, since
# registering it would produce a market that reverts on its first priced call.
PRICE_MAX_AGE_SECONDS=300

# Widest accepted Pyth confidence interval, in basis points of the price.
# 100 = 1%. Pyth's `conf` is roughly a standard error, so this rejects prices
# the publishers disagree on instead of liquidating off the midpoint. Capped at
# 500 by Constants.MAX_PRICE_CONF_BPS.
PRICE_MAX_CONF_BPS=100

# --- Stablecoin revenue, applied by scripts/deploy-stablecoin.js ---
# The protocol's cut of the yield YieldTreasury distributes, in basis points.
# Default 1000 = 10%, which is Lido's fee on staking rewards. Capped at 2000 by
# YieldTreasury.MAX_PERFORMANCE_FEE_BPS. Taken off incoming yield before it
# reaches depositors' index, so it only ever charges a gain that already
# happened — unlike kfUSD's mint and redeem fees, which are now 5 bps each
# (0.1% round trip, down from 0.6%) precisely because an entry toll charges
# principal instead. Set to 0 to waive; the fee recipient reuses
# KALEIDO_FEE_VAULT above so all protocol revenue lands in one place.
KFUSD_PERFORMANCE_FEE_BPS=1000

# REQUIRED by scripts/deploy-stablecoin.js. USDC on the target chain.
#
# The only collateral that script does not deploy itself — USDT and USDe are
# created during the run, so their addresses are right by construction. This one
# is external and per-chain, and it used to default to Abstract testnet's
# 0x572f4901f03055ffC1D936a60Ccc3CbF13911BE3.
#
# A wrong value here does not fail the deploy. It is consumed by three
# privileged writes — setYieldAsset, kfUSD.setCollateralSupport and
# kafUSD.setAssetSupport — and all three accept any non-zero address, so the run
# completes and prints a summary naming "USDC" while the collateral list holds
# something else entirely. There is no default now, and the script checks the
# address has code and answers decimals() before spending gas. The decimals
# matter beyond existence: kfUSD.sol:270-284 scales redemptions by them, so a
# "USDC" reporting 18 is a different asset from one reporting 6.
USDC_ADDRESS=

# OPTIONAL for scripts/deploy-stablecoin.js. Existing USDT and USDe on the
# target chain — set these ONLY on a redeploy.
#
# On a first deploy, leave both blank: the script deploys fresh USDT/USDe mocks
# as it always has. On a redeploy — replacing kfUSD/kafUSD/YieldTreasury on a
# chain that already has collateral, a faucet dripping it and pools seeded
# against it — set them to the live addresses so the new stack reuses that
# collateral instead of minting a second, orphaned token. A fresh mock would
# leave the faucet dripping the old token and make gen-registry.mjs throw on the
# two disagreeing USDT records. Verified on chain (code + decimals) exactly like
# USDC; a set-but-wrong address is a hard error, never a silent fall-through to
# deploying a mock.
USDT_ADDRESS=
USDE_ADDRESS=

# --- DEX, applied by scripts/deploy-v3.js and scripts/deploy-dex.js ---
# REQUIRED by both scripts, which read it from the environment at run time
# rather than from this file:
#
#   WRAPPED_NATIVE=0x... npx hardhat run scripts/deploy-v3.js --network baseTestnet
#
# The wrapped-native token on the target chain. It cannot be guessed from the
# native symbol — on Arc it wraps USDC, not ether. Both scripts verify code
# exists at it, because an address copied from another chain produces a router
# that reverts on every native-token path and nothing fails until then.
#
# Use the SAME value for both scripts on a given chain. It is an immutable
# constructor argument to the V2 and V3 routers alike, so a mismatch means the
# two venues wrap native into different tokens and their "ETH" liquidity is not
# fungible. `npm run gen:registry` errors rather than picking one if the two
# deployment records disagree.
WRAPPED_NATIVE=

# Read by scripts/deploy-v3.js only. The ticker rendered inside every position
# NFT's SVG, via NonfungibleTokenPositionDescriptor's immutable
# nativeCurrencyLabelBytes. Defaults to ETH.
#
# Wrong here is permanent and retroactive: it cannot be changed without
# redeploying the descriptor, and already-minted positions render with it.
# Per chain: ETH on Sepolia, Base Sepolia and Robinhood; NATIVE_LABEL=BNB on BSC
# Testnet; NATIVE_LABEL=USDC on Arc Testnet, whose native currency is USDC.
NATIVE_LABEL=ETH

# Optional, read by scripts/deploy-dex.js. Holder of the V2 factory's feeToSetter
# role, which controls the V2 protocol fee. Defaults to the deployer.
#
# Set it to the multisig, or remember to hand it over alongside Diamond
# ownership — otherwise protocol-fee control stays on a deploy key whose only
# other job is finished.
V2_FEE_TO_SETTER=

# --- Lending assets, applied by scripts/register-tokens.js (runs LAST) ---
# Until this script runs the lending market has no assets at all: every entry
# point on ProtocolFacet that touches a token checks `s_priceFeeds[token] != 0`,
# so with the mapping empty depositCollateral, createLendingRequest,
# createLoanListing and every health-factor read revert with
# Protocol__TokenNotAllowed. deploy.js prints these calls as "still required"
# and then leaves them undone.

# Optional. The diamond to register against. Falls back to reading
# deployment-diamond-<network>.json, which deploy.js writes — so on a chain you
# just deployed, leave this blank and let the file speak.
KALEIDO_DIAMOND=

# At least one of these two is required. Comma-separated SYMBOL=address, with a
# bare `NATIVE` allowed for the address(1) sentinel:
#
#   COLLATERAL_TOKENS="NATIVE,WETH=0x...,USDC=0x...,USDT=0x..."
#   LOANABLE_TOKENS="USDC=0x...,USDT=0x..."
#
# The symbol is not cosmetic — it selects the price feed, and the script compares
# it against the token's own on-chain symbol() before sending anything. A
# mistyped address therefore fails as a symbol mismatch rather than becoming a
# mispriced market.
#
# `NATIVE` needs registering explicitly. depositCollateral(address(1), …) runs
# the same allowlist check as any ERC20, so without it native deposits revert
# while WETH deposits work — a failure that looks like a wallet problem.
#
# Order matters and the script enforces it: both addCollateralToken and
# addLoanableToken write s_priceFeeds, but only the former checks it is empty
# first. Registering a token as loanable before registering it as collateral bars
# it from the collateral set permanently. Also note addLoanableToken has no
# duplicate guard and nothing anywhere removes from s_loanableToken, so a re-run
# without the script's pre-flight check would grow that array forever.
COLLATERAL_TOKENS=
LOANABLE_TOKENS=

# Which Pyth feed prices the chain's native currency. Defaults to ETH, which is
# right on three of the five testnets and wrong on two.
#
# NATIVE_FEED_SYMBOL=BNB on BSC Testnet. Leaving it at ETH there would price a
# BNB deposit off ether — roughly a 6x overvaluation of the borrower's
# collateral, which lets them over-borrow. That is a solvency hole, not a display
# bug, and nothing reverts to announce it.
# NATIVE_FEED_SYMBOL=USDC on Arc Testnet, whose native currency is USDC.
NATIVE_FEED_SYMBOL=ETH

# Optional, per symbol: FEED_ETH, FEED_USDC, FEED_USDT, FEED_USDE, FEED_BNB,
# FEED_BTC, FEED_WBTC, FEED_WETH. A 32-byte Pyth feed id (66 chars with 0x) that
# overrides the table in scripts/libraries/pyth-feeds.js, so a wrong literal
# there can never block a deploy. Verified exactly the same way as a table entry.
# Uncomment and set only when you have a reason to.
#FEED_USDT=

# Optional. SKIP_HERMES=1 turns OFF the off-chain half of the feed check. Feeds
# are still proven to exist on the target chain, but no longer proven to name the
# asset you think they do — and a wrong-but-real feed id never reverts, it
# misprices the asset forever. Use it only when Hermes is unreachable and the
# chain is one you will tear down. HERMES_ENDPOINT overrides the endpoint
# (default https://hermes.pyth.network) if you run your own.
#SKIP_HERMES=1
#HERMES_ENDPOINT=
